root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csx}]
dotnet_sort_system_directives_first = true

# ── Style preferences ────────────────────────────────────────────────────────
#
# Severities are declared separately, as dotnet_diagnostic.<id>.severity below,
# rather than with the legacy `value:severity` suffix. The combined form is not
# read consistently across SDK versions: under the .NET 11 SDK it left the `var`
# preferences at their defaults and the build failed with 316 IDE0008 errors on
# code that had been clean under .NET 10. Declaring the two halves separately is
# the supported form and behaves the same on every SDK.

csharp_style_namespace_declarations = file_scoped
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
csharp_style_expression_bodied_methods = when_on_single_line
csharp_style_expression_bodied_properties = true
csharp_style_expression_bodied_constructors = when_on_single_line
csharp_style_expression_bodied_lambdas = true
csharp_style_expression_bodied_operators = true
csharp_style_prefer_switch_expression = true
csharp_style_prefer_pattern_matching = true
csharp_prefer_simple_using_statement = true
csharp_style_prefer_primary_constructors = true
csharp_prefer_braces = when_multiline

# ── Enforced at build time ───────────────────────────────────────────────────
# These catch real problems, not formatting opinions.

dotnet_diagnostic.IDE0005.severity = warning   # unnecessary using directive
dotnet_diagnostic.IDE0028.severity = warning   # collection initialization can be simplified
dotnet_diagnostic.IDE0270.severity = warning   # null check can be simplified
dotnet_diagnostic.IDE0300.severity = warning   # collection expression for array
dotnet_diagnostic.IDE0301.severity = warning   # collection expression for empty
dotnet_diagnostic.IDE0305.severity = warning   # collection expression for fluent
dotnet_diagnostic.IDE0330.severity = warning   # use System.Threading.Lock
dotnet_diagnostic.IDE0060.severity = warning   # unused parameter
dotnet_diagnostic.IDE1006.severity = warning   # naming rules

# ── Deliberately not enforced ────────────────────────────────────────────────
# Formatting choices this codebase makes on purpose. Left as suggestions so the
# IDE still offers them, but they never fail a build — and, more to the point,
# they never start failing one because someone installed a newer SDK.

dotnet_diagnostic.IDE0007.severity = suggestion  # use var
dotnet_diagnostic.IDE0008.severity = none        # use explicit type; this codebase uses var
dotnet_diagnostic.IDE0011.severity = none        # braces; single-line guard clauses are idiomatic here
dotnet_diagnostic.IDE0021.severity = suggestion  # expression body for constructor
dotnet_diagnostic.IDE0022.severity = suggestion  # expression body for method
dotnet_diagnostic.IDE0024.severity = suggestion  # block body for operator
dotnet_diagnostic.IDE0046.severity = suggestion  # convert to conditional expression
dotnet_diagnostic.IDE0058.severity = none        # unused expression value

[*.{json,yml,yaml}]
indent_size = 2

[*.{props,targets,csproj}]
indent_size = 2
