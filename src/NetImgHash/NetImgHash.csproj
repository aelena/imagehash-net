<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PerceptualHash.NET</PackageId>
    <Title>PerceptualHash.NET</Title>
    <Version>0.3.0</Version>
    <Description>Cross-platform perceptual image hashing for .NET built on ImageSharp. Implements aHash and dHash, with output verified against the Python imagehash reference implementation.</Description>
    <Authors>aelena</Authors>
    <Company>aelena</Company>
    <!-- These pointed at github.com/aelena/NetImgHash, which does not exist; the
         repository is imagehash-net, so every link on the NuGet page 404'd. -->
    <PackageProjectUrl>https://github.com/aelena/imagehash-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aelena/imagehash-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>imagehash;imagesharp;perceptual;hashing;similarity;ahash;dhash;duplicate-detection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
